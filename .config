# 核心：指定目标系统和子平台（对应 RE-CS-07 所需）
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_generic=y

# 基础编译配置（新手默认即可，保证编译能正常运行）
CONFIG_DEVEL=y
CONFIG_TOOLCHAINOPTS=y
CONFIG_BUILD_LOG=y

# 可选：添加 LuCI 网页管理界面（后续固件刷入后可直接登录网页管理，推荐）
CONFIG_LUCI=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_LUCI_THEME_fanchmwrt=y

# 基础系统工具（保证固件基本功能）
CONFIG_PACKAGE_busybox_full=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_opkg=y
