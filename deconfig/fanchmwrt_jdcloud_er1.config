# ========== 硬件平台配置（必选） ==========
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_er1=y  # 京东云太乙设备标识
CONFIG_TARGET_ROOTFS_SQUASHFS=y  # 生成squashfs格式固件（适配刷机）

# ========== fanchmwrt核心功能包（必选） ==========
CONFIG_PACKAGE_fcm-base=y
CONFIG_PACKAGE_fcm-firewall=y

# ========== 硬件优化（IPQ6010专属） ==========
CONFIG_PACKAGE_kmod-nss=y  # NSS硬件加速（提升网络性能）
CONFIG_PACKAGE_kmod-nft-fullconenat=y  # FullConeNAT（优化P2P连接）
CONFIG_PACKAGE_kmod-usb-storage=y  # 启用USB存储支持

# ========== 常用插件（按需增减） ==========
CONFIG_PACKAGE_luci=y  # LuCI网页管理界面
CONFIG_PACKAGE_luci-app-adguardhome=y  # 广告过滤
CONFIG_PACKAGE_luci-app-openclash=y  # 网络代理
CONFIG_PACKAGE_luci-app-samba4=y  # USB文件共享
# V2ray 相关（核心程序+网页管理界面）
CONFIG_PACKAGE_v2ray-core=y  # V2ray 核心运行程序（必选）
CONFIG_PACKAGE_luci-app-v2ray=y  # V2ray LuCI 网页管理界面（方便配置）
CONFIG_PACKAGE_luci-i18n-v2ray-zh-cn=y  # V2ray 中文语言包（可选，优化使用体验）
